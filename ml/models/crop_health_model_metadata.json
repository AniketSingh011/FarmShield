{
    "model": "XGBoost",
    "target": "Crop_Health",
    "features": [
        "Soil_Moisture",
        "Soil_Temperature",
        "Soil_pH",
        "Humidity",
        "Air_Temperature",
        "Solar_Radiation",
        "Wind_Speed",
        "NDVI_Index",
        "5G_Latency_ms"
    ],
    "classes": {
        "0": "Healthy",
        "1": "Moderate_Stress",
        "2": "High_Stress"
    },
    "dataset_rows": 2000,
    "test_size": 0.2,
    "random_state": 42,
    "metrics": {
        "accuracy": 0.3175,
        "precision": 0.3167465277777778,
        "recall": 0.3175,
        "f1_score": 0.3169818606192459
    }
}